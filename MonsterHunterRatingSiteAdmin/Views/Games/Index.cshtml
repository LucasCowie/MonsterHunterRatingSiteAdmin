@model IEnumerable<MonsterHunterRatingSiteAdmin.Models.Game>

@{
    ViewData["Title"] = "Index";
}

<div class="page-header">
    <div class="d-flex align-items-center gap-3 me-auto">
        <h1>Manage Games</h1>
        <a asp-controller="Generations" asp-action="Index" class="btn btn-outline-warning">Manage Generation</a>
        <a asp-controller="GameConsoles" asp-action="Index" class="btn btn-outline-warning">Manage Game Console</a>
    </div>
    <a asp-action="Create" class="btn btn-primary">+ Add Game</a>
</div>
<div class="table-card">
<table class="table table-hover align-middle mh-table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Title)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.GameIcon)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Description)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Generation)
            </th>
            <th>
                    @Html.DisplayNameFor(model => model.GameConsole)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.NumMonster)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ReleaseDate)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.Title)
            </td>
            <td>
                <img src="@item.GameIcon" alt="@item.Title" class="img-thumbnail" style="width: 60px; height: 80px; object-fit: cover;" />
            </td>
            <td>
                @Html.DisplayFor(model => item.Description)
            </td>
            <td>
                @Html.DisplayFor(model => item.Generation.Name)
            </td>
            <td>
                @Html.DisplayFor(model => item.GameConsole.Name)
            </td>
            <td>
                @Html.DisplayFor(model => item.NumMonster)
            </td>
            <td>
                @Html.DisplayFor(model => item.ReleaseDate)
            </td>
            <td class="text-nowrap">
                <a class="btn btn-sm btn-outline-warning" asp-action="Edit" asp-route-id="@item.Id">Edit</a>
                <a class="btn btn-sm btn-outline-light" asp-action="Details" asp-route-id="@item.Id">Details</a>
                <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
</div>
