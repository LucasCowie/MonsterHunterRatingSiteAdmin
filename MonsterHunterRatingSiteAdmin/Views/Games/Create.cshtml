@model MonsterHunterRatingSiteAdmin.Models.Game

@{
    ViewData["Title"] = "Create";
}

<div class="page-header">
    <h1>Add Game</h1>
</div>
<div class="row">
    <div class="col-md-6 mh-card">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="Title" class="control-label"></label>
                <input asp-for="Title" class="form-control" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="GameIcon" class="control-label"></label>
                <input asp-for="GameIcon" class="form-control" />
                <span asp-validation-for="GameIcon" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Description" class="control-label"></label>
                <input asp-for="Description" class="form-control" />
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Generation" class="control-label"></label>
                <select asp-for="Generation" class="form-select" asp-items="MonsterHunterRatingSiteAdmin.Models.GameOptions.GenerationItems">
                    <option value="">-- Select generation --</option>
                </select>
                <span asp-validation-for="Generation" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Console" class="control-label"></label>
                <select asp-for="Console" class="form-select" asp-items="MonsterHunterRatingSiteAdmin.Models.GameOptions.ConsoleItems">
                    <option value="">-- Select console --</option>
                </select>
                <span asp-validation-for="Console" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="NumMonster" class="control-label"></label>
                <input asp-for="NumMonster" class="form-control" />
                <span asp-validation-for="NumMonster" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="ReleaseDate" class="control-label"></label>
                <input asp-for="ReleaseDate" class="form-control" type="date" min="2004-03-11" max="2100-01-01" />
                <span asp-validation-for="ReleaseDate" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div class="mt-3">
    <a class="back-link" asp-action="Index">&larr; Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
