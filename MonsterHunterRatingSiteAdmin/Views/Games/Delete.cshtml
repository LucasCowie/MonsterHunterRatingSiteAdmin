@model MonsterHunterRatingSiteAdmin.Models.Game

@{
    ViewData["Title"] = "Delete";
}

<div class="page-header">
    <h1>Delete Game</h1>
</div>

<div class="mh-card mh-card-danger">
    <h4 class="mb-3">Are you sure you want to delete this?</h4>
    <dl class="row mh-details">
        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.Title)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.Title)
        </dd>
        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.GameIcon)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.GameIcon)
        </dd>
        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.Description)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.Description)
        </dd>
        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.Generation)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.Generation)
        </dd>
        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.Console)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.Console)
        </dd>
        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.NumMonster)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.NumMonster)
        </dd>
        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.ReleaseDate)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.ReleaseDate)
        </dd>
    </dl>
    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Delete" class="btn btn-danger" />
        <a class="back-link ms-3" asp-action="Index">&larr; Back to List</a>
    </form>
</div>
