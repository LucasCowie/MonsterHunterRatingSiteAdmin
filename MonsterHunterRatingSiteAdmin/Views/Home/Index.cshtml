@{
    ViewData["Title"] = "Home Page";
}

<div class="page-header">
    <h1>Monster Hunter Rating Site &mdash; Admin</h1>
</div>

<div class="mh-card">
    <p>This is the back office for the Monster Hunter Rating Site.</p>
    <ul>
        <li><strong>Administrators</strong> add, edit and delete games, generations and consoles, and upload each game's poster.</li>
        <li><strong>Critics</strong> browse the games and write one review per game, with a rating from 0 to 5. Reviews stay editable as drafts until they are published.</li>
    </ul>

    @if (User.Identity?.IsAuthenticated == true)
    {
        <p class="mb-0">Signed in as <strong>@User.Identity.Name</strong>.</p>
        @if (User.IsInRole("administrator") || User.IsInRole("critic"))
        {
            <a class="btn btn-primary mt-3" asp-controller="Games" asp-action="Index">Go to Games</a>
        }
        else
        {
            <p class="text-muted mt-2 mb-0">Your account has no role yet. Ask an administrator to assign one.</p>
        }
    }
    else
    {
        <p>Please log in to continue.</p>
        <a class="btn btn-primary" asp-controller="Account" asp-action="Login">Login</a>
    }
</div>
