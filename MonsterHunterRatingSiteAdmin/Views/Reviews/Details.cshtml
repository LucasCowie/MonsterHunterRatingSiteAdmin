@model MonsterHunterRatingSiteAdmin.Models.ReviewGame

@{
    ViewData["Title"] = "Review Details";
}

<div class="page-header">
    <h1>Review Details</h1>
</div>

<div class="mh-card">
    <dl class="row mh-details">
        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.GameId)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.Game!.Title)
        </dd>
        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.Rating)
        </dt>
        <dd class="col-sm-9">
            @Model.Rating / 5
        </dd>
        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.Description)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.Description)
        </dd>
        <dt class="col-sm-3">
            Status
        </dt>
        <dd class="col-sm-9">
            @(Model.IsPublished ? "Published" : "Draft")
        </dd>
        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.CreatedDate)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.CreatedDate)
        </dd>
    </dl>
</div>
<div class="mt-3">
    @if (!Model.IsPublished)
    {
        <a class="btn btn-outline-warning" asp-action="Edit" asp-route-id="@Model.Id">Edit</a>
    }
    <a class="back-link ms-3" asp-action="Index">&larr; Back to My Reviews</a>
</div>
